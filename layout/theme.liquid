<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}"{%- if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' -%} dir="rtl"{%- endif -%}>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- unless settings.type_heading_font.system? and settings.type_body_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>
      {{ page_title }}
      {%- if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %}
        &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %}
        &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>

    {{ content_for_header }}

    {%- render 'settings' -%}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'swiper-bundle.min.css' | asset_url | stylesheet_tag }}
    <link rel="stylesheet" href="{{ 'component-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
    <noscript>
      {{ 'component-drawer.css' | asset_url | stylesheet_tag }}
    </noscript>

    {%- if settings.predictive_search_enabled -%}
      <link rel="stylesheet" href="{{ 'component-predictive-search.css' | asset_url }}" media="print" onload="this.media='all'">
      <script src="{{- 'predictive-search.js' | asset_url -}}" defer="defer"></script>
      <noscript>
        {{- 'component-predictive-search.css' | asset_url | stylesheet_tag -}}
      </noscript>
    {%- endif -%}

    {% comment %}theme-check-disable AssetPreload{% endcomment %}
    {%- unless settings.type_heading_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_heading_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {% comment %}theme-check-enable AssetPreload{% endcomment %}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');

      if (Shopify.designMode) {
        document.documentElement.classList.add('shopify-design-mode');
      }
    </script>

    <script src="{{- 'swiper-bundle.min.js' | asset_url -}}" defer="defer"></script>
  </head>

  <body class="template template--{{ template.name }}{% if template.suffix %} template--{{- template.suffix -}}{% endif %} is-at-top">
    <a class="skip-to-content-link button visually-hidden" href="#MainContent" role="button">
      {{- 'accessibility.skip_to_content' | t -}}
    </a>

    {%- sections 'header-group' -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- liquid
      sections 'footer-group'
      sections 'overlay-group'

      section 'cart-drawer'
    -%}

    <ul hidden>
      <li id="a11y-refresh-page-message">{{- 'accessibility.refresh_page' | t -}}</li>
    </ul>

    <script>
      window.theme = window.theme || {};
      theme = {
        settings: {
          money_with_currency_format: {{ shop.money_format | json }},
          cart_free_shipping_threshold: {{ settings.shipping_notification_threshold | times: 100 }},
          cart_free_shipping_text: `{{ 'cart.shipping_bar.progress_html' | t: amount: '0' }}`,
          cart_free_shipping_text_success: `{{ 'cart.shipping_bar.success' | t }}`,
        },
        strings: {
          loading: {{ 'actions.loading' | t | json }},
          soldOut: {{ 'info.sold_out' | t | json }},
          unavailable: {{ 'info.unavailable' | t | json }},
          addToCart: {{ 'products.product.add_to_cart' | t | json }},
          preOrder: {{ 'products.product.preorder.button' | t | json }},
          addSubscriptionToCart: {{ 'products.product.add_subscription_to_cart' | t | json }},
          productUnavailable: {{ 'products.product.unavailable' | t | json }},
          recipientFormExpanded: {{ 'recipient.form.expanded' | t | json }},
          recipientFormCollapsed: {{ 'recipient.form.collapsed' | t | json }},
          cartError: {{ 'cart.cart_error' | t | json }},
          cartQuantityError: {{ 'cart.cart_quantity_error_html' | t: quantity: '[quantity]' | json }},
          formInvalidEmail: {{ 'form.invalid_email' | t | json }}
        }
      }
      window.shopUrl = '{{ request.origin }}';
      window.routes = {
        cart_add_url: '{{ routes.cart_add_url }}',
        cart_change_url: '{{ routes.cart_change_url }}',
        cart_update_url: '{{ routes.cart_update_url }}'
      };
    </script>

    {% if settings.enable_back_to_top_button %}
      {% render 'back-to-top' %}
    {% endif %}
    {% section 'quick-cart-modal' %}
  </body>
</html>

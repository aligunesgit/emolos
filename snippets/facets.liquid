{% comment %}
    Renders facets
    Accepts:
    - results: {Object} Collection or Search object
    - section: {Object} Section
    Usage:
    {%- render 'facets', results: collection, section: section -%}
{% endcomment %}

{%- liquid
  assign enable_filtering = enable_filtering | default: false
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total_active_values = 0
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms | append: '&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  endif
  assign results_sort_url = results.url | append: '?sort_by=' | append: sort_by
-%}

{%- if section.settings.enable_sorting and plp_layout != true -%}
  {{- 'component-custom-select.css' | asset_url | stylesheet_tag -}}

  <script src="{{- 'custom-select.js' | asset_url -}}" defer="defer"></script>
{%- endif -%}

<facet-filters-form class="collection-facets{% if plp_layout %} collection-facets--plp{% endif %}{% if search.results_count == 0 %} collection-facets__no-result{% endif %}" data-section-id="{{- section.id -}}">
  <div class="container max-w-{{ section.settings.section_width }}">
    <div class="collection-facets__inner">
      {%- if search.results_count != 0 and enable_filtering or section.settings.enable_sorting -%}
        <div class="collection-facets__item">
          <div class="facets">
            <form id="FacetFiltersForm" class="facets__form">
              {%- if results.terms -%}
                <input type="hidden" name="q" value="{{- results.terms | escape -}}">
                <input name="options[prefix]" type="hidden" value="last">
              {%- endif -%}

              {%- if results.current_vendor or results.current_type -%}
                <input type="hidden" name="q" value="{{- results.current_vendor -}}{{- results.current_type -}}">
              {%- endif -%}

              <ul class="facets__actions-list list-unstyled">
                {%- if enable_filtering and results.filters != empty or plp_layout and section.settings.enable_sorting -%}
                  <li class="facets__actions-item {% if filters_style == 'sidebar' %}collection__aside-filters-actions-item{% endif %}">
                    <menu-drawer class="drawer{% unless plp_layout %} drawer--start{% endunless %} drawer--sm facets__drawer{% if plp_layout %} plp-filters-drawer{% endif %}">
                      <details id="Filters-drawer-{{- section.id -}}" class="drawer__container">
                        <summary
                          class="drawer__button facets__actions-button svg-color-inherit focus-inset"
                          id="Filters-drawer-button-{{- section.id -}}"
                          aria-label="{{- 'collection.plp.filters_sort' | t -}}"
                          tabindex="0"
                        >
                          <span>
                            {{- 'collection.facets.filters_button' | t -}}
                          </span>

                          <noscript>
                            {% render 'icon', icon_name: 'theme-arrow-close' %}
                          </noscript>
                        </summary>

                        <div
                          class="drawer__content js-drawer color-scheme-1 gradient{% if plp_layout %} plp-filters{% endif %}"
                          id="Filters-menu-drawer-{{- section.id -}}"
                          tabindex="-1"
                        >
                          {%- if plp_layout -%}
                            {%- liquid
                              assign active_filter_count = 0
                              for filter in results.filters
                                assign active_filter_count = active_filter_count | plus: filter.active_values.size
                              endfor
                            -%}
                            <div class="plp-filters__header">
                              <div class="plp-filters__header-title">
                                <span class="plp-filters__header-icon" aria-hidden="true">
                                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                                    <path d="M10 13.4404H4M15.56 13.4404H13.56" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"></path>
                                    <path d="M11.9986 15.0001C12.4137 15.0001 12.8117 14.8352 13.1052 14.5417C13.3987 14.2482 13.5636 13.8502 13.5636 13.4351C13.5636 13.0201 13.3987 12.622 13.1052 12.3285C12.8117 12.035 12.4137 11.8701 11.9986 11.8701C11.5835 11.8701 11.1855 12.035 10.892 12.3285C10.5985 12.622 10.4336 13.0201 10.4336 13.4351C10.4336 13.8502 10.5985 14.2482 10.892 14.5417C11.1855 14.8352 11.5835 15.0001 11.9986 15.0001Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                                    <path d="M6 6.55957H4M15.69 6.55957H9.69" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"></path>
                                    <path d="M8.13141 8.13C8.54647 8.13 8.94453 7.96512 9.23803 7.67162C9.53152 7.37813 9.69641 6.98006 9.69641 6.565C9.69641 6.14994 9.53152 5.75187 9.23803 5.45838C8.94453 5.16488 8.54647 5 8.13141 5C7.71634 5 7.31828 5.16488 7.02478 5.45838C6.73129 5.75187 6.56641 6.14994 6.56641 6.565C6.56641 6.98006 6.73129 7.37813 7.02478 7.67162C7.31828 7.96512 7.71634 8.13 8.13141 8.13Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
                                  </svg>
                                </span>
                                <h2 class="plp-filters__heading">{{- 'collection.plp.filters_sort' | t -}}</h2>
                                {%- if active_filter_count > 0 -%}
                                  <span class="plp-filters__heading-count">{{- active_filter_count -}}</span>
                                {%- endif -%}
                              </div>
                              <button
                                class="plp-filters__close button-reset js-btn-close-drawer"
                                type="button"
                                aria-label="{{- 'actions.close' | t -}}"
                              >
                                {% render 'icon', icon_name: 'theme-close' %}
                              </button>
                            </div>

                            <div class="plp-filters__applied js-facets-active{% if active_filter_count == 0 %} hidden{% endif %}">
                              <p class="plp-filters__applied-title">{{- 'collection.plp.applied_filters' | t -}}</p>
                              <ul class="plp-filters__applied-list list-unstyled">
                                {%- for filter in results.filters -%}
                                  {%- for value in filter.active_values -%}
                                    <li>
                                      <a href="{{- value.url_to_remove -}}" class="plp-filters__applied-pill">
                                        {{- value.label | escape -}}
                                        <span aria-hidden="true">&times;</span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- else -%}
                            <button
                              class="drawer__button-close svg-color-inherit button-reset no-js-hidden js-btn-close-drawer"
                              aria-label="{{- 'actions.close' | t -}}"
                              aria-controls="Filters-menu-drawer-{{- section.id -}}"
                              aria-expanded="false"
                            >
                              {% render 'icon', icon_name: 'theme-arrow-close' %}
                            </button>

                            <h2 class="drawer__title drawer__title--mb-lg heading-static">
                              {{- 'collection.facets.filters_title' | t -}}
                            </h2>
                          {%- endif -%}

                          <div class="drawer__row drawer__row--mb-lg{% if plp_layout %} plp-filters__body{% endif %}">
                            <accordion-default class="accordion facets__accordion">
                              {%- if plp_layout and section.settings.enable_sorting -%}
                                {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
                                <details class="accordion__section facets__accordion-section" id="Filters-accordion-section-sort">
                                  <summary class="facets__accordion-btn h4 js-btn" id="Filters-accordion-button-sort">
                                    <span class="plp-filters__summary-text">{{- 'collection.facets.sort_by_label' | t -}}</span>
                                    <div class="facets__accordion-icon svg-color-inherit plp-filters__toggle">
                                      <span class="plp-filters__icon-plus">{% render 'icon', icon_name: 'theme-plus' %}</span>
                                      <span class="plp-filters__icon-minus">{% render 'icon', icon_name: 'theme-minus' %}</span>
                                    </div>
                                  </summary>
                                  <div class="accordion__body facets__accordion-body" id="Filters-accordion-dropdown-sort">
                                    <ul class="facets__list list-unstyled plp-filters__pills" role="list">
                                      {%- for option in results.sort_options -%}
                                        <li class="facets__item">
                                          <input
                                            type="radio"
                                            name="sort_by"
                                            id="Filter-sort-{{- option.value | handleize -}}"
                                            value="{{- option.value | escape -}}"
                                            class="visually-hidden"
                                            {% if option.value == sort_by %}checked{% endif %}
                                          >
                                          <label class="plp-filters__pill" for="Filter-sort-{{- option.value | handleize -}}">
                                            {{- option.name | escape -}}
                                          </label>
                                        </li>
                                      {%- endfor -%}
                                    </ul>
                                  </div>
                                </details>
                              {%- endif -%}
                              {%- for filter in results.filters -%}
                                {%- render 'facet', index: forloop.index, section_id: section.id, filter: filter, plp_layout: plp_layout -%}
                              {%- endfor -%}
                            </accordion-default>
                          </div>

                          <div class="drawer__row drawer__row--buttons{% if plp_layout %} plp-filters__footer{% endif %}">
                            {%- if plp_layout -%}
                              <facet-remove class="plp-filters__footer-clear">
                                <a href="{{- results_sort_url -}}" class="plp-filters__footer-btn plp-filters__footer-btn--clear">
                                  {{- 'collection.plp.remove_all' | t -}}
                                  {%- if active_filter_count > 0 -%}
                                    <span class="plp-filters__heading-count">{{- active_filter_count -}}</span>
                                  {%- endif -%}
                                </a>
                              </facet-remove>
                              <button type="button" class="plp-filters__footer-btn plp-filters__footer-btn--apply js-btn-close-drawer">
                                {{- 'collection.plp.apply' | t -}}
                                {%- if active_filter_count > 0 -%}
                                  <span class="plp-filters__heading-count">{{- active_filter_count -}}</span>
                                {%- endif -%}
                              </button>
                            {%- else -%}
                              {%- assign clear_text = 'collection.facets.clear_all' | t | escape -%}
                              <facet-remove>
                                {%- render 'button', type: 'link', class: 'button button--full facets__clear-button', button_style: 'button--outlined', value: clear_text, href: results_sort_url -%}
                              </facet-remove>
                              {%- assign show_results_button_value = 'collection.facets.filters_submit' | t | escape -%}
                              {%- render 'button', type: 'button', class: 'button button--full js-btn-close-drawer no-js-hidden', button_style: 'button--filled', value: show_results_button_value -%}
                            {%- endif -%}
                          </div>
                        </div>
                      </details>
                    </menu-drawer>
                  </li>
                {%- endif -%}

                {%- if section.settings.enable_sorting and plp_layout != true -%}
                  <li class="facets__actions-item js-filter" data-index="sort-by">
                    {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}

                    <custom-select
                      class="custom-select facets__custom-select"
                      data-dropdown-id="SortByDropdown"
                      data-sort-label="{{- 'collection.facets.sort_by_label' | t -}}"
                    >
                      <div class="facets__sort no-js">
                        <label for="SortBy" class="select-input__label visually-hidden">{{- 'collection.facets.sort_by_label' | t -}}:</label>

                        <select
                          name="sort_by"
                          class="facets__sort-input facets__actions-button focus-inset"
                          id="SortBy"
                          aria-describedby="a11y-refresh-page-message"
                        >
                          {%- for option in results.sort_options -%}
                            <option value="{{- option.value | escape -}}"{% if option.value == sort_by %} selected="selected"{% endif %}>
                              {{- option.name | escape -}}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    </custom-select>
                  </li>
                {%- endif -%}

                <li class="facets__actions-item no-js">
                  <button type="submit" class="button button--filled button--full button--full-height button--border-none">
                    {{- 'collection.facets.apply' | t -}}
                  </button>
                </li>
              </ul>
            </form>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.enable_products_count and plp_layout != true -%}
        <div class="collection-facets__item">
          <div class="collection-facets__status" role="status">
            <span id="ProductCount">
              {%- if results.results_count -%}
                {{ 'search.results_with_count_and_term' | t: terms: results.terms, count: results.results_count }}
              {%- elsif results.products_count == results.all_products_count -%}
                {{ 'collection.facets.product_count_simple' | t: count: results.products_count }}
              {%- else -%}
                {{ 'collection.facets.product_count' | t: product_count: results.products_count, count: results.all_products_count }}
              {%- endif -%}
            </span>
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.products_per_row_ui -%}
        <div
          class="collection-facets__item collection-facets__item--view small-hide medium-hide no-js-hidden{% if results.products_count == 0 %} hidden{% endif %}"
          aria-hidden="true"
        >
          <script src="{{- 'collection-view.js' | asset_url -}}" defer="defer"></script>

          <collection-view class="collection-facets__view">
            <ul class="collection-facets__view-items list-unstyled">
              {%- for index in (3..4) -%}
                {%- capture index_string -%}
                  {{- index -}}
                {%- endcapture -%}

                <li class="collection-facets__view-item">
                  <button
                    type="button"
                    class="collection-facets__view-button button-reset js-btn"
                    data-cols="{{- index -}}"
                    {% if section.settings.products_per_row_default == index_string %}disabled{% endif %}
                  >
                    <span class="collection-facets__view-rectangle"></span>

                    <span class="collection-facets__view-rectangle"></span>

                    <span class="collection-facets__view-rectangle"></span>

                    {%- if forloop.last -%}
                      <span class="collection-facets__view-rectangle"></span>
                    {%- endif -%}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          </collection-view>
        </div>
      {%- endif -%}
    </div>
  </div>
</facet-filters-form>

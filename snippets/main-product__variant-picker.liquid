{%- liquid
  if context_type == blank
    assign context_type = 'product'
  endif
-%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign show_size_guide = show_size_guide | default: true -%}
{%- assign variant_picker_layout = block.settings.variant_picker_layout | default: 'buttons' -%}
{%- unless variant_picker_layout == 'buttons' or variant_picker_layout == 'dropdowns' or variant_picker_layout == 'stacked' -%}
  {%- assign variant_picker_layout = 'buttons' -%}
{%- endunless -%}

{%- if product.has_only_default_variant == false -%}
  <product-selector id="ProductSelector-{{- section.id -}}"
    class="product-selector{% if variant_picker_layout == 'stacked' %} product-selector--{{ variant_picker_layout }} product-selector--dropdowns{% else %} product-selector--{{ variant_picker_layout }}{% endif %}"
    data-url="{%- if collection -%}{{- collection.url -}}{%- endif -%}{{- product.url -}}"
    data-section-id="{{- section.id -}}"
    data-installments-form-id="#{{- product_form_installments_id -}}"
    {% if product.requires_selling_plan %}data-product-requires-selling-plan{% endif %}
    {% if context_type == 'modal' %}data-context="modal"{% endif %}
    {{ block.shopify_attributes }}
  >
    <input type="hidden" name="id" value="{{- current_variant.id -}}" {% if form_id %}form="{{ form_id }}"{% elsif product_form_id %}form="{{ product_form_id }}"{% endif %}>
    {%- liquid
      assign variants_available_arr = product.variants | map: 'available'
      assign variants_option_one_arr = product.variants | map: 'option1'
    -%}
    {% unless settings.input_border_radius == 0 %}
      {% style %}
        .product-options__value-list .slim-scrollbar {
          scrollbar-width: none;
        }
      {% endstyle %}
    {% endunless %}
    {% capture size_guide_trigger %}
      <button
        type="button"
        class="product__size-guide-link js-size-guide-open"
        aria-haspopup="dialog"
        aria-controls="SizeGuide-{{ section.id }}"
      >
        <svg class="product__size-guide-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M14.93 4.11L12.1 1.28a1 1 0 00-1.41 0L6.8 5.17.78 11.18a1 1 0 000 1.42l2.82 2.82a1 1 0 001.42 0l9.9-9.9a1 1 0 000-1.4zm-10.6 10.6L1.48 11.9l1.41-1.41 1.06 1.06a.5.5 0 00.71-.71L3.61 9.77l1.42-1.42 1.05 1.06a.5.5 0 00.71-.7L5.73 7.65l1.42-1.42L8.2 7.3c.2.2.5.2.7 0s.2-.5 0-.7L7.85 5.53 9.27 4.1l1.06 1.06a.5.5 0 00.71-.7L9.98 3.4 11.39 2l2.83 2.83-9.9 9.9z"></path>
        </svg>
        <span class="product__size-guide-text">{{- 'products.product.size_guide' | t -}}</span>
      </button>
    {% endcapture %}
    {%- liquid
      assign size_guide_page = nil
      assign size_guide_html = ''
      assign size_guide_title = ''
      assign sg_field = product.metafields.custom.size_guide
      if sg_field == blank
        assign sg_field = product.metafields.custom.size_chart
      endif
      if sg_field == blank
        assign sg_field = product.metafields.shopify.size-chart
      endif
      if sg_field != blank
        if sg_field.type == 'page_reference'
          assign size_guide_page = sg_field.value
        else
          assign size_guide_html = sg_field | metafield_tag
          if size_guide_html == blank
            assign size_guide_html = sg_field.value
          endif
        endif
      endif
      if size_guide_page == nil and product.template_suffix != blank
        assign sg_handle = product.template_suffix | append: '-size-guide'
        if pages[sg_handle].content != blank
          assign size_guide_page = pages[sg_handle]
        endif
      endif
      if size_guide_page == nil and product.type != blank
        assign sg_handle = product.type | handle | append: '-size-guide'
        if pages[sg_handle].content != blank
          assign size_guide_page = pages[sg_handle]
        endif
      endif
      if size_guide_page == nil and block.settings.size_guide_page != blank
        assign size_guide_page = block.settings.size_guide_page
      endif
      if size_guide_page == nil and pages['size-guide'].content != blank
        assign size_guide_page = pages['size-guide']
      endif
      if size_guide_page != nil
        assign size_guide_title = size_guide_page.title
        assign size_guide_html = size_guide_page.content
      endif
      if size_guide_title == blank
        assign size_guide_title = product.title | append: ' Size Guide'
      endif
    -%}
    {%- for option in product.options_with_values -%}
      {%- liquid
        assign option_name_down = option.name | downcase
        assign swatch_name_down = settings.swatches_option | downcase
        assign is_colour_option = false
        assign is_size_option = false
        if option_name_down == swatch_name_down or option_name_down == 'color' or option_name_down == 'colour'
          assign is_colour_option = true
        endif
        if option.name == settings.sizes_option or option_name_down == 'size'
          assign is_size_option = true
        endif
      -%}
      {%- if context_type != 'modal' and is_size_option and variant_picker_layout == 'stacked' and size_guide_html != blank -%}
        <span class="product__size-guide">{{ size_guide_trigger }}</span>
      {%- endif -%}
      {%- liquid
        assign product_option_handle = option.name | handle
        assign product_option_href = 'product-option--' | append: product_option_handle | append: '-' | append: section.id
      -%}

      <fieldset class="product-options{% if is_colour_option %} product-options--colour{% endif %}{% if is_size_option %} product-options--size{% endif %}{% if product.has_only_default_variant %} hidden{% endif %}" data-input-wrapper id="{{ product_option_href -}}">
        <legend class="product-selector__label">
          {%- if is_colour_option -%}
            COLOUR
          {%- else -%}
            {{- option.name -}}
          {%- endif -%}
          {%- if context_type == 'modal' and is_size_option -%}
            <button type="button" class="quick-cart-size-chart__trigger">
              {{- 'products.product.size_chart' | t -}}
            </button>
          {%- endif -%}
          {%- if context_type != 'modal' and is_size_option and variant_picker_layout != 'stacked' and size_guide_html != blank -%}
            <span class="product__size-guide">{{ size_guide_trigger }}</span>
          {%- endif -%}
        </legend>
        {%- capture options_html -%}
          {%- for value in option.values -%}
            {%- liquid
              assign option_disabled = value.available
              assign id = 'Bar-option-' | append: section.id | append: '-' | append: option.name | append: '-' | append: forloop.index0
              assign name = 'options[' | append: option.name | append: ']'

              for option1_name in variants_option_one_arr
                unless option.position != 1
                  if variants_option_one_arr[forloop.index0] == value and variants_available_arr[forloop.index0]
                    assign option_disabled = false
                  endif
                endunless
              endfor
            -%}
            <li>
              {%- liquid
                assign attr = ''
                assign class = ''
                assign show_label = true

                if option.selected_value == value
                  assign class = class | append: ' is-active'
                  assign attr = 'checked'
                endif
                unless value.available
                  assign option_disabled = true
                else
                  assign option_disabled = false
                endunless
                unless back_in_stock
                  if option_disabled
                    assign attr = attr | append: ' disabled'
                  endif
                endunless
                if variant_picker_layout != 'buttons'
                  assign show_label = true
                endif
                assign name = 'options[' | append: option.name | append: ']'

                if option_disabled
                  assign class = class | append: ' product-options__item--disabled'
                endif

                render 'product-option', value: value, class: class, id: id, name: name, attr: attr, show_label: show_label, back_in_stock: back_in_stock, option_value_id: value.id, where: 'product', option: option, product: product
              -%}
            </li>
          {%- endfor -%}
          {%- unless back_in_stock -%}
            {%- style -%}
              .product-options__item.product-options__item--disabled {
                pointer-events: none;
              }
            {%- endstyle -%}
          {%- endunless -%}
        {%- endcapture -%}

        <div class="product-options__value-list js-product-options-value-list" data-open="false">
          <ul class="slim-scrollbar">
            {{- options_html -}}
          </ul>
          {% render 'icon', icon_name: 'theme-chevron-down' %}
        </div>
        {%- liquid
          assign id = nil
          assign name = nil
        -%}
      </fieldset>
    {%- endfor -%}

    <script type="application/json">
      {{- product.variants | json -}}
    </script>
  </product-selector>
  {%- if context_type != 'modal' and size_guide_html != blank -%}
    <dialog class="product-size-guide-modal" id="SizeGuide-{{ section.id }}" aria-labelledby="SizeGuideTitle-{{ section.id }}">
      <div class="product-size-guide-modal__window">
        <button type="button" class="product-size-guide-modal__close js-size-guide-close" aria-label="{{- 'actions.close' | t -}}">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
            <path d="M18 6 6 18M6 6l12 12"></path>
          </svg>
        </button>
        <div class="product-size-guide-modal__content rte">
          <h2 class="product-size-guide-modal__title" id="SizeGuideTitle-{{ section.id }}">{{- size_guide_title -}}</h2>
          <div class="product-size-guide-modal__table-wrap">
            {{- size_guide_html -}}
          </div>
        </div>
      </div>
    </dialog>
    <script>
      (function () {
        var dialog = document.getElementById('SizeGuide-{{ section.id }}');
        if (!dialog) return;
        document.querySelectorAll('[aria-controls="SizeGuide-{{ section.id }}"]').forEach(function (btn) {
          btn.addEventListener('click', function (event) {
            event.preventDefault();
            if (typeof dialog.showModal === 'function') dialog.showModal();
            else dialog.setAttribute('open', '');
          });
        });
        dialog.querySelectorAll('.js-size-guide-close').forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          });
        });
        dialog.addEventListener('click', function (event) {
          if (event.target === dialog) {
            if (typeof dialog.close === 'function') dialog.close();
            else dialog.removeAttribute('open');
          }
        });
      })();
    </script>
  {%- endif -%}
{%- endif -%}

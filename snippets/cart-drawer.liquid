{%- comment -%}
  Renders cart drawer

  Usage:
  {%- render 'cart-drawer' -%}
{%- endcomment -%}

{{- 'component-cart-drawer.css' | asset_url | stylesheet_tag -}}

<link rel="stylesheet" href="{{ 'component-cart.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-items.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-cart-recommendations.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>
  {{- 'component-cart.css' | asset_url | stylesheet_tag -}}
  {{- 'component-cart-items.css' | asset_url | stylesheet_tag -}}
  {{- 'component-cart-recommendations.css' | asset_url | stylesheet_tag -}}
</noscript>

<script src="{{- 'cart.js' | asset_url -}}" defer="defer"></script>
<script src="{{- 'cart-drawer.js' | asset_url -}}" defer="defer"></script>
<script src="{{- 'cart-recommendations.js' | asset_url -}}" defer="defer"></script>

{%- style -%}
  cart-drawer {
    --cart-item-media-aspect-ratio: {{ section.settings.card_media_aspect_ratio }};
  }
{%- endstyle -%}

<cart-drawer>
  <div class="cart-drawer color-{{ section.settings.color_scheme }} gradient" id="{{- section.id -}}">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>

    <div
      class="cart-drawer__inner"
      role="dialog"
      aria-modal="true"
      aria-label="{{- 'cart.title' | t -}}"
      tabindex="-1"
    >
      <div class="cart-drawer__head">
        <p class="cart-drawer__title" id="CartDrawer-Title">
          {{- 'cart.title' | t -}} ({{ cart.item_count }})
        </p>

        <button
          class="cart-drawer__close svg-color-inherit"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{- 'actions.close' | t -}}"
          tabindex="-1"
          data-drawer-close
        >
          {% render 'icon', icon_name: 'theme-close' %}
        </button>
      </div>

      <div class="cart-drawer__body{% if section.settings.sticky_checkout_button %} cart-drawer__body--pb-none{% endif %}" id="CartDrawer-Body" data-cart-body>
        {%- if cart == empty -%}
          <div class="cart-drawer__empty">
            <p class="cart-drawer__empty-text">{{- 'cart.empty' | t -}}</p>

            {%-
              liquid
              assign value = 'cart.continue_shopping' | t
              render 'button', type: 'link', href: section.settings.button_url, value: value, style: 'solid', fullwidth: true, class: 'button cart-drawer__checkout'
              assign value = nil
            -%}
          </div>
        {%- else -%}
          <cart-drawer-items>
            <div class="cart-drawer__spinner">
              {%- render 'loading-spinner' -%}
            </div>

            <form
              action="{{- routes.cart_url -}}"
              id="CartDrawer-Form"
              class="cart-drawer__form"
              method="post"
            >
              <div class="cart-drawer__contents" id="CartDrawer-CartItems">
                <div class="cart-drawer__items">
                  {%- for line_item in cart.items -%}
                    {%- render 'line-item', line_item: line_item, in_drawer: true -%}
                  {%- endfor -%}
                </div>
              </div>
            </form>
          </cart-drawer-items>

          {%- render 'cart-recommendations', class: 'cart-drawer__recommendations' -%}

          <div class="cart-drawer__summary{% if section.settings.sticky_checkout_button %} cart-drawer__summary--sticky{% endif %}">
            <form
              action="{{- routes.cart_url -}}"
              id="CartDrawer-FormSummary"
              class="cart-drawer__form-summary"
              method="post"
            >
              <div id="cart-summary">
                <div class="cart-drawer__summary-total">
                  <span>
                    {{- 'cart.subtotal' | t -}}:
                  </span>

                  <span>
                    {{- cart.total_price | money -}}
                  </span>
                </div>

                {%- if cart.cart_level_discount_applications.size > 0 -%}
                  <ul class="cart-drawer__summary-discounts list-unstyled" role="list" aria-label="{{- 'customer.order.discount' | t -}}">
                    {%- for discount in cart.cart_level_discount_applications -%}
                      <li>
                        {% render 'icon', icon_name: 'option-price_tag' %}
                        <span>
                          {{ discount.title }}
                          (-{{ discount.total_allocated_amount | money }})
                        </span>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

                <p class="cart-drawer__summary-tax">
                  {{- 'cart.shipping_and_discounts_at_checkout' | t -}}
                </p>

                <div class="cart-drawer__summary-actions">
                  {%-
                    liquid
                    assign value = 'cart.checkout' | t
                    render 'button', type: 'submit', name: 'checkout', value: value, style: 'solid', fullwidth: true, class: 'button cart-drawer__checkout'
                    assign value = nil
                  -%}
                </div>
              </div>
            </form>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</cart-drawer>

<div class="quick-cart-product-modal">
  {%- liquid
    assign product_images = product.media | where: 'media_type', 'image'
    assign product_models = product.media | where: 'media_type', 'model'
    assign product_media = product_images | concat: product_models | sort: 'position'
  -%}

  <button
    type="button"
    class="button--close"
    aria-label="{{- 'actions.close' | t -}}"
    aria-expanded="false"
    aria-controls="quick-cart-modal"
    tabindex="0"
  >
    {% render 'icon', icon_name: 'theme-close' %}
  </button>

  {%- if product_media.size > 0 -%}
    <div class="product__grid__item product__grid__item--media">
      <div class="quick-cart-product-modal__media" data-slide-count="{{- product_media.size -}}">
        <div class="swiper" data-quick-cart-slider id="QuickCartSlider-{{ product.id }}">
          <div class="swiper-wrapper">
            {%- for media in product_media -%}
              <div class="swiper-slide" data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                <img
                  src="{{ media.preview_image | image_url: width: 1200 }}"
                  srcset="{{ media.preview_image | image_url: width: 600 }} 600w, {{ media.preview_image | image_url: width: 900 }} 900w, {{ media.preview_image | image_url: width: 1200 }} 1200w"
                  sizes="(min-width: 750px) 240px, 100vw"
                  alt="{{ media.alt | default: product.title | escape }}"
                  width="{{ media.preview_image.width }}"
                  height="{{ media.preview_image.height }}"
                  loading="eager"
                  fetchpriority="{% if forloop.first %}high{% else %}low{% endif %}"
                >
              </div>
            {%- endfor -%}
          </div>
        </div>
        {%- if product_media.size > 1 -%}
          <div class="swiper-buttons">
            <button type="button" class="swiper-button swiper-button--prev" aria-label="{{- 'actions.previous' | t -}}">
              {% render 'icon', icon_name: 'theme-arrow' %}
            </button>
            <button type="button" class="swiper-button swiper-button--next" aria-label="{{- 'actions.next' | t -}}">
              {% render 'icon', icon_name: 'theme-arrow' %}
            </button>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="product__content">
    <div class="quick-cart-product-modal__info">
      <div class="product__title-wrapper h2 product__title heading-static">
        {{- product.title | escape -}}
      </div>

      {%- liquid
        assign rating_value = 0
        if product.metafields.reviews.rating.value.rating != blank
          assign rating_value = product.metafields.reviews.rating.value.rating
        elsif product.metafields.loox.avg_rating != blank
          assign rating_value = product.metafields.loox.avg_rating
        endif
        assign rating_filled = rating_value | round
        if rating_filled > 5
          assign rating_filled = 5
        endif
        if rating_filled < 0
          assign rating_filled = 0
        endif
      -%}
      <div class="quick-cart-product-modal__rating" aria-label="{{- rating_value -}} / 5">
        {%- for i in (1..5) -%}
          <span class="quick-cart-product-modal__star{% if i <= rating_filled %} is-filled{% endif %}" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 0.8L7.35 4.35L11.2 4.65L8.3 7.2L9.15 11L6 9.05L2.85 11L3.7 7.2L0.8 4.65L4.65 4.35L6 0.8Z" fill="currentColor"></path>
            </svg>
          </span>
        {%- endfor -%}
      </div>

      <div class="product__price">
        {%- render 'price', product_ref: product, use_variant: true, show_sale_badge: false -%}
      </div>

      <product-card
        class="product-card product-card__quick-cart-modal"
        {% if product.metafields.theme.preorder.value %}
          data-has-pre-order
        {% endif %}
      >
        <div class="product-card__variants">
          {%- liquid
            assign modal_context_id = 'quick-cart-modal-' | append: product.id
            assign modal_form_id = 'product-form-' | append: product.id | append: '-modal'
          -%}

          {%- render 'main-product__variant-picker',
            product: product,
            context_id: modal_context_id,
            context_type: 'modal',
            form_id: modal_form_id,
            show_size_guide: false
          -%}

          <script
            data-product-variants-json
            type="application/json"
          >
            {{- product.variants | json -}}
          </script>
        </div>

        {%- liquid
          assign product_preorder = false
          if product.metafields.theme.preorder.value
            assign product_preorder = true
          endif
          assign modal_form_id = 'product-form-' | append: product.id | append: '-modal'
        -%}

        {%- form 'product',
          product,
          class: 'product-card__add-to-cart--form product__form',
          novalidate: 'novalidate',
          id: modal_form_id
        -%}
          <input type="hidden" name="id" value="{{- product.first_available_variant.id -}}">
          <button
            type="submit"
            class="button button--filled button--uppercase quick-cart-product-modal__submit"
            {% unless product.available %}
              disabled
            {% endunless %}
          >
            <span>
              {%- if product_preorder -%}
                {{ 'products.product.preorder.title' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
          </button>
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
        {%- endform -%}

        <a href="{{- product.url -}}" class="quick-cart-product-modal__product-link">
          <span>{{- 'products.card-product.view_full_product' | t -}}</span>
          {% render 'icon', icon_name: 'theme-chevron' %}
        </a>
      </product-card>
    </div>
  </div>

  {%- liquid
    assign size_option = product.options_by_name[settings.sizes_option]
  -%}
  <div class="quick-cart-size-chart" hidden>
    <div class="quick-cart-size-chart__panel" role="dialog" aria-modal="true" aria-labelledby="QuickCartSizeChartTitle">
      <button type="button" class="quick-cart-size-chart__close" aria-label="{{- 'actions.close' | t -}}">
        {% render 'icon', icon_name: 'theme-close' %}
      </button>
      <h2 id="QuickCartSizeChartTitle" class="quick-cart-size-chart__title heading-static">
        {{- product.title | escape -}}
      </h2>
      <p class="quick-cart-size-chart__subtitle">{{- 'products.product.size_charts' | t -}}</p>
      <div class="quick-cart-size-chart__units" role="tablist">
        <button type="button" class="quick-cart-size-chart__unit is-active" data-unit="cm">
          {{- 'products.product.size_chart_cm' | t -}}
        </button>
        <span class="quick-cart-size-chart__unit-sep" aria-hidden="true">|</span>
        <button type="button" class="quick-cart-size-chart__unit" data-unit="in">
          {{- 'products.product.size_chart_inches' | t -}}
        </button>
      </div>

      {%- if size_option != blank -%}
        <div class="quick-cart-size-chart__table-wrap" data-unit-table="cm">
          <table class="quick-cart-size-chart__table">
            <thead>
              <tr>
                <th>Size</th>
                <th>WAIST</th>
                <th>INSIDE LEG SEAM</th>
              </tr>
            </thead>
            <tbody>
              {%- for value in size_option.values -%}
                {%- assign size_number = value.name | plus: 0 -%}
                <tr>
                  <td>{{- value -}}</td>
                  <td>
                    {%- if size_number > 0 -%}
                      {{- size_number | plus: 9 -}}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                  <td>81.3</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
        <div class="quick-cart-size-chart__table-wrap" data-unit-table="in" hidden>
          <table class="quick-cart-size-chart__table">
            <thead>
              <tr>
                <th>Size</th>
                <th>WAIST</th>
                <th>INSIDE LEG SEAM</th>
              </tr>
            </thead>
            <tbody>
              {%- for value in size_option.values -%}
                {%- assign size_number = value.name | plus: 0 -%}
                <tr>
                  <td>{{- value -}}</td>
                  <td>
                    {%- if size_number > 0 -%}
                      {{- size_number | plus: 9 | times: 10.0 | divided_by: 25.4 | round: 1 -}}
                    {%- else -%}
                      —
                    {%- endif -%}
                  </td>
                  <td>32</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      {%- endif -%}

      <div class="quick-cart-size-chart__howto">
        <p><strong>1. WAIST:</strong> For measuring the waist first button the pants up. Next spread the pants flat on the surface, and remove any fullness and wrinkles from it.</p>
        <p><strong>2. INSEAM:</strong> Having the pants buttoned up, spread the pants on a surface flat. Now measure the inseam gap from the crotch, at the spot where the front and back seams meet, exactly where, depends on the length you desire ultimately.</p>
      </div>
    </div>
  </div>
</div>

<div class="quick-cart-product-modal">
  {%- liquid
    assign product_images = product.media | where: 'media_type', 'image'
    assign product_models = product.media | where: 'media_type', 'model'
    assign product_media = product_images | concat: product_models | sort: 'position'
  -%}

  {% liquid
    assign adaptive_ratio_setting = section.settings.adaptive_ratio_and_auto_height | default: 'default'
    assign product_media_layout_setting = section.settings.product_media_layout | default: 'product__media-layout--slider'
    assign media_aspect_ratio_setting = section.settings.media_aspect_ratio | default: 'default'

    case adaptive_ratio_setting
      when 'slider_auto_height'
        assign adaptive_ratio = true
        assign slider_auto_height = true
      when 'adaptive_ratio'
        assign adaptive_ratio = true
        assign slider_auto_height = false
      else
        assign adaptive_ratio = false
        assign slider_auto_height = false
    endcase
  %}

  <button
    type="button"
    class="button--close"
    aria-label="{{- 'actions.close' | t -}}"
    aria-expanded="false"
    aria-controls="quick-cart-modal"
    tabindex="0"
  >
    {% render 'icon', icon_name: 'theme-close' %}
  </button>

  {%- if product.media.size > 0 -%}
    <div class="grid__item product__grid__item product__grid__item--media">
      <product-media
        class="product__media {{ product_media_layout_setting }} {% if adaptive_ratio_setting == "default" %} product__media--fit{% endif %}"
        data-auto-height="{{ slider_auto_height }}"
        data-layout="{{- product_media_layout_setting -}}"
      >
        {%- liquid
          assign slides_html = ''
          assign addition_swiper_class = 'swiper'
          if product_media.size == 1
            assign addition_swiper_class = addition_swiper_class | append: ' one-slide'
          endif
          if product_media.size > 0
            for media in product_media
              capture slides_html
                echo slides_html
                render 'product-media', media: media, output_type: 'slider-slide', media_index: forloop.index0, preserve_aspect_ratio: adaptive_ratio, section_index: 0, media_aspect_ratio: media_aspect_ratio_setting
              endcapture
            endfor
          endif
        -%}

        {% liquid
          assign swiper_options = '{'
          assign swiper_options = swiper_options | append: '"slidesPerView": 1'
          assign swiper_options = swiper_options | append: ', "slidesPerViewDesktop": 1'
          assign swiper_options = swiper_options | append: ', "direction": "horizontal"'
          assign swiper_options = swiper_options | append: ', "directionDesktop": "horizontal"'
          assign swiper_options = swiper_options | append: ', "disablePagination": true'
          assign swiper_options = swiper_options | append: ', "spaceBetween": 0'
          assign swiper_options = swiper_options | append: ', "resistanceRatio": 0'
          assign swiper_options = swiper_options | append: ', "centerInsufficientSlides": false'
          assign swiper_options = swiper_options | append: '}'
        %}

        <div class="product__media-slider relative {{ product_media_layout_setting }}">
          <div
            class="{{- addition_swiper_class -}}"
            data-slider
            data-swiper-options='{{- swiper_options -}}'
            id="product-media-gallery"
          >
            <div class="swiper-wrapper">
              {{- slides_html -}}
            </div>
          </div>

          {%- if product_media.size > 1 -%}
            <div class="swiper-buttons no-js-hidden">
              <button type="button" class="swiper-button swiper-button--prev" aria-label="{{- 'actions.previous' | t -}}">
                {% render 'icon', icon_name: 'theme-arrow' %}
              </button>
              <button type="button" class="swiper-button swiper-button--next" aria-label="{{- 'actions.next' | t -}}">
                {% render 'icon', icon_name: 'theme-arrow' %}
              </button>
            </div>
          {%- endif -%}
        </div>

        <div class="hidden" data-close-icon>{% render 'icon', icon_name: 'theme-close' %}</div>
        <div class="hidden" data-prev-icon>{% render 'icon', icon_name: 'theme-arrow' %}</div>
        <div class="hidden" data-next-icon>{% render 'icon', icon_name: 'theme-arrow' %}</div>
      </product-media>
    </div>
  {%- endif -%}

  <div class="product__content">
    <div class="quick-cart-product-modal__info">
      <div class="product__title-wrapper h2 product__title heading-static">
        {{- product.title | escape -}}
      </div>

      <div class="quick-cart-product-modal__rating" aria-hidden="true">
        {%- for i in (1..5) -%}
          <span class="quick-cart-product-modal__star">
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 0.8L7.35 4.35L11.2 4.65L8.3 7.2L9.15 11L6 9.05L2.85 11L3.7 7.2L0.8 4.65L4.65 4.35L6 0.8Z" fill="currentColor"></path>
            </svg>
          </span>
        {%- endfor -%}
      </div>

      <div class="product__price">
        {%- render 'price', product_ref: product, use_variant: true, show_sale_badge: false -%}
      </div>

      <product-card
        class="product-card product-card__quick-cart-modal"
        {% if product.metafields.theme.preorder.value %}
          data-has-pre-order
        {% endif %}
      >
        <div class="product-card__variants">
          {%- liquid
            assign modal_context_id = 'quick-cart-modal-' | append: product.id
            assign modal_form_id = 'product-form-' | append: product.id | append: '-modal'
          -%}

          {%- render 'main-product__variant-picker',
            product: product,
            context_id: modal_context_id,
            context_type: 'modal',
            form_id: modal_form_id,
            show_size_guide: false
          -%}

          <script
            data-product-variants-json
            type="application/json"
          >
            {{- product.variants | json -}}
          </script>
        </div>

        {%- liquid
          assign product_preorder = false
          if product.metafields.theme.preorder.value
            assign product_preorder = true
          endif
          assign modal_form_id = 'product-form-' | append: product.id | append: '-modal'
        -%}

        {%- form 'product',
          product,
          class: 'product-card__add-to-cart--form product__form',
          novalidate: 'novalidate',
          id: modal_form_id
        -%}
          <input type="hidden" name="id" value="{{- product.first_available_variant.id -}}">
          <button
            type="submit"
            class="button button--filled button--uppercase quick-cart-product-modal__submit"
            {% unless product.available %}
              disabled
            {% endunless %}
          >
            <span>
              {%- if product_preorder -%}
                {{ 'products.product.preorder.title' | t }}
              {%- else -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- endif -%}
            </span>
          </button>
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="product-form__error-message"></span>
          </div>
        {%- endform -%}

        <a href="{{- product.url -}}" class="quick-cart-product-modal__product-link">
          <span>{{- 'products.card-product.view_full_product' | t -}}</span>
          {% render 'icon', icon_name: 'theme-chevron' %}
        </a>
      </product-card>
    </div>
  </div>
</div>

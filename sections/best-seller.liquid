{{- 'section-best-seller.css' | asset_url | stylesheet_tag -}}
<script src="{{ 'best-seller.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit | default: 8
  assign size_option_name = settings.sizes_option | default: 'Size'
  assign products = collection.products
-%}

{%- if collection != blank and products.size > 0 -%}
  <div class="best-seller">
    <header class="best-seller__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="best-seller__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if products.size > 2 -%}
        <div class="best-seller__nav small-hide no-js-hidden">
          <button type="button" class="best-seller__nav-button best-seller__nav-button--prev" aria-label="Previous">
            <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              <path d="M 20,50 L 60,90 L 60,85 L 25,50 L 60,15 L 60,10 Z"></path>
            </svg>
          </button>
          <button type="button" class="best-seller__nav-button best-seller__nav-button--next" aria-label="Next">
            <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
              <path d="M 80,50 L 40,90 L 40,85 L 75,50 L 40,15 L 40,10 Z"></path>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </header>

    <div class="best-seller__slider-wrap">
      <best-seller-slider class="best-seller__slider">
        <div class="best-seller__track">
          {%- for product in products limit: product_limit -%}
            {%- liquid
              assign size_option = product.options_by_name[size_option_name]
              assign featured_image = product.featured_image
              assign hover_image = product.images[1]
              assign variant = product.selected_or_first_available_variant
            -%}
            <div class="best-seller__slide">
              <article class="best-seller__card" data-product-id="{{ product.id }}">
                <div class="best-seller__visual">
                <a class="best-seller__media" href="{{ product.url }}">
                  {%- if featured_image != blank -%}
                    {{
                      featured_image
                      | image_url: width: 900
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 480, 720, 900',
                        sizes: '(min-width: 1140px) 25vw, (min-width: 750px) 33vw, 62vw',
                        alt: product.title,
                        class: 'best-seller__img'
                    }}
                    {%- if hover_image != blank -%}
                      {{
                        hover_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 480, 720, 900',
                          sizes: '(min-width: 1140px) 25vw, (min-width: 750px) 33vw, 62vw',
                          alt: product.title,
                          class: 'best-seller__img best-seller__img--hover'
                      }}
                    {%- endif -%}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg best-seller__img' }}
                  {%- endif -%}
                </a>

                <div class="best-seller__quick" data-default-variant="{{ variant.id }}">
                  {%- if size_option != blank -%}
                    <div class="best-seller__sizes">
                      {%- for size_value in size_option.values -%}
                        {%- liquid
                          assign size_variant = nil
                          assign size_available = false
                          for product_variant in product.variants
                            if product_variant.options contains size_value
                              assign size_variant = product_variant
                              if product_variant.available
                                assign size_available = true
                                break
                              endif
                            endif
                          endfor
                        -%}
                        <button
                          type="button"
                          class="best-seller__size{% unless size_available %} best-seller__size--unavailable{% endunless %}"
                          data-variant-id="{{ size_variant.id }}"
                          {% unless size_available %}disabled{% endunless %}
                        >
                          {{ size_value }}
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  <button
                    type="button"
                    class="best-seller__add"
                    data-variant-id="{{ variant.id }}"
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    ADD TO BAG
                  </button>
                </div>
                </div>

                <div class="best-seller__info">
                  <a class="best-seller__title" href="{{ product.url }}">{{ product.title }}</a>
                  <div class="best-seller__price">
                    {%- liquid
                      assign card_price = variant.price
                      assign card_compare = variant.compare_at_price
                      if card_compare == blank or card_compare == 0
                        assign card_compare = product.compare_at_price
                      endif
                      if card_compare == blank or card_compare == 0
                        assign card_compare = product.compare_at_price_max
                      endif
                    -%}
                    {%- if card_compare != blank and card_compare > card_price -%}
                      <span class="best-seller__price-sale">{{ card_price | money }}</span>
                      <span class="best-seller__price-compare">{{ card_compare | money }}</span>
                    {%- else -%}
                      <span class="best-seller__price-regular">{{ card_price | money }}</span>
                    {%- endif -%}
                  </div>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>
      </best-seller-slider>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="best-seller__footer">
        <a
          class="best-seller__button"
          href="{{ section.settings.button_link | default: collection.url }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Best Seller",
  "tag": "section",
  "class": "section-best-seller",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "BEST SELLER"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 16,
      "step": 1,
      "label": "Maximum products",
      "default": 8
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "VIEW ALL PRODUCTS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Best Seller"
    }
  ]
}
{% endschema %}

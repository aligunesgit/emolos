{{- 'section-newsletter-signup.css' | asset_url | stylesheet_tag -}}

{% schema %}
{
  "name": "Email Signup",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Title",
      "default": "UNLOCK 10% OFF"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Description",
      "default": "Sign up for an instant discount, plus early access, new products and more."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SIGN UP"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount Code",
      "default": "WX10XVNQ2KPG"
    }
  ],
  "presets": [
    {
      "name": "Email Signup + Discount"
    }
  ]
}
{% endschema %}

<div class="newsletter-wrapper">
  {% unless form_success %}
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.subtext }}</p>

    <form id="newsletter-form" method="post" action="#" onsubmit="showThankYou(); return false;">
      <input type="email" name="contact[email]" placeholder="e-mail" required>
      <br>

      <button type="submit">
        {{ section.settings.button_text }}
      </button>
    </form>
  {% else %}
    <h2>THANK YOU!</h2>
    <p>Copy and paste your code at checkout to get 10% off your next order:</p>
    <div style="display: inline-block; border: 1px dashed black; padding: 1rem 2rem; font-weight: bold; font-size: 1.2rem; background-color: #f5f5f5;">
      {{ section.settings.discount_code }}
      <button onclick="copyCode()" style="background: none; border: none; cursor: pointer; margin-left: 10px;">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M10 1.5A1.5 1.5 0 0 1 11.5 3v9A1.5 1.5 0 0 1 10 13.5H4A1.5 1.5 0 0 1 2.5 12V3A1.5 1.5 0 0 1 4 1.5h6zM4 0a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3H4z"/>
        </svg>
      </button>
    </div>
    <p style="margin-top: 1rem; font-size: 0.8rem;">
      By signing up, you agree to receive email marketing from EMOLOS. <a href="#" style="color: #007BFF;">T&Cs Apply</a>
    </p>
  {% endunless %}
</div>

<script>
  function showThankYou() {
    document.querySelector('.newsletter-wrapper').innerHTML = `
      <h2>THANK YOU!</h2>
      <p>Copy and paste your code at checkout to get 10% off your next order:</p>
      <div style="display: inline-block; border: 1px dashed black; padding: 1rem 2rem; font-weight: bold; font-size: 1.2rem; background-color: #f5f5f5;">
        {{ section.settings.discount_code }}
        <button onclick="copyCode()" style="background: none; border: none; cursor: pointer; margin-left: 10px;">
          <svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' fill='currentColor' viewBox='0 0 16 16'>
            <path d='M10 1.5A1.5 1.5 0 0 1 11.5 3v9A1.5 1.5 0 0 1 10 13.5H4A1.5 1.5 0 0 1 2.5 12V3A1.5 1.5 0 0 1 4 1.5h6zM4 0a3 3 0 0 0-3 3v9a3 3 0 0 0 3 3h6a3 3 0 0 0 3-3V3a3 3 0 0 0-3-3H4z'/>
          </svg>
        </button>
      </div>
      <p style='margin-top: 1rem; font-size: 0.8rem;'>
        By signing up, you agree to receive email marketing from EMOLOS.
      </p>
    `;
  }

  function copyCode() {
    navigator.clipboard.writeText('{{ section.settings.discount_code }}');
    alert('Copied!');
  }
</script>
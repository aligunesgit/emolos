{{- 'section-new-in.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign new_in_image = section.settings.image
  if section.settings.image_mobile != blank
    assign new_in_image_mobile = section.settings.image_mobile
  else
    assign new_in_image_mobile = new_in_image
  endif

  assign image_alt = section.settings.heading
  if image_alt == blank
    assign image_alt = section.settings.content | strip_html | strip
  endif

  assign has_text = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.content != blank or section.settings.link_label != blank
    assign has_text = true
  endif

  assign has_link = false
  if section.settings.link != blank or section.settings.link_label != blank
    assign has_link = true
  endif

  assign image_position = section.settings.layout
  if image_position == blank
    assign image_position = section.settings.image_position
  endif
  if image_position == blank
    assign image_position = 'right'
  endif
-%}

<div class="new-in new-in--image-{{ image_position }}">
  {%- if has_text -%}
    <div class="new-in__content">
      <div class="new-in__content-inner">
        {%- if section.settings.eyebrow != blank -%}
          <p class="new-in__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="new-in__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.content != blank -%}
          <div class="new-in__description">{{ section.settings.content }}</div>
        {%- endif -%}

        {%- if section.settings.link_label != blank -%}
          <a
            class="new-in__link"
            href="{{ section.settings.link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.link_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if new_in_image != blank or new_in_image_mobile != blank -%}
    {%- if has_link -%}
      <a
        class="new-in__media"
        href="{{ section.settings.link | default: routes.all_products_collection_url }}"
        aria-label="{{ section.settings.link_label | default: image_alt | escape }}"
      >
    {%- else -%}
      <div class="new-in__media">
    {%- endif -%}
      {%- if new_in_image != blank and new_in_image_mobile != blank and new_in_image != new_in_image_mobile -%}
        <picture>
          <source
            media="(max-width: 749px)"
            srcset="{{ new_in_image_mobile | image_url: width: 400 }} 400w, {{ new_in_image_mobile | image_url: width: 600 }} 600w, {{ new_in_image_mobile | image_url: width: 800 }} 800w, {{ new_in_image_mobile | image_url: width: 1000 }} 1000w, {{ new_in_image_mobile | image_url: width: 1200 }} 1200w"
            sizes="100vw"
          >
          {{
            new_in_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 800, 1000, 1200, 1600',
              sizes: '(min-width: 750px) 35vw, 100vw',
              alt: image_alt,
              class: 'new-in__img'
          }}
        </picture>
      {%- elsif new_in_image_mobile != blank and new_in_image == blank -%}
        {{
          new_in_image_mobile
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 35vw, 100vw',
            alt: image_alt,
            class: 'new-in__img'
        }}
      {%- else -%}
        {{
          new_in_image
          | image_url: width: 1600
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200, 1600',
            sizes: '(min-width: 750px) 35vw, 100vw',
            alt: image_alt,
            class: 'new-in__img'
        }}
      {%- endif -%}
    {%- if has_link -%}
      </a>
    {%- else -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <div class="new-in__media">
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg new-in__img' }}
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "New In",
  "tag": "section",
  "class": "section-new-in",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Image position",
      "options": [
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "TRENDING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Description",
      "default": "<p>Discover Our New Arrivals</p>",
      "info": "You can bold, italicize, or mix styles in this text."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "SHOP NEW IN"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional. Desktop image is used on mobile when empty."
    }
  ],
  "presets": [
    {
      "name": "New In",
      "settings": {
        "layout": "right",
        "eyebrow": "TRENDING",
        "heading": "NEW ARRIVALS",
        "content": "<p>Discover Our New Arrivals</p>",
        "link_label": "SHOP NEW IN"
      }
    }
  ]
}
{% endschema %}
